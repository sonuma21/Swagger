                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "location"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Udhauli Chasok Parva"
                                    },
                                    "location": {
                                        "type": "string",
                                        "example": "Dharan"
                                    }
                                },
                                "type": "object"
                            }
                        }
